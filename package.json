{
  "name": "threadpoint-dev-tools",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "format:prettier": "prettier --write --ignore-unknown . && prettier --write --parser markdown \"**/*.mdc\" \"**/.cursorrules\"",
    "format:prettier:check": "prettier --check --ignore-unknown . && prettier --check --parser markdown \"**/*.mdc\" \"**/.cursorrules\""
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
